generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  active
  past_due
  locked
  cancelled
}

enum UserRole {
  owner
  staff
  platform_admin
}

enum AgentStatus {
  draft
  live
  paused
}

enum ConversationChannel {
  chat
  voice
}

enum ConversationStatus {
  in_progress
  completed
  abandoned
}

enum OutcomeType {
  demo_booking
  order
  complaint
  appointment
}

enum CrmProvider {
  hubspot
}

enum IntegrationType {
  calendar
  email
  webhook
}

// ─────────────────────────────────────────────────────────────
// Core tenancy
// ─────────────────────────────────────────────────────────────

model Tenant {
  id                 String             @id @default(cuid())
  name               String
  industry           String?
  subscriptionStatus SubscriptionStatus @default(active)
  priceConfig        Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users           User[]
  agents          Agent[]
  conversations   Conversation[]
  crmConnections  CrmConnection[]
  integrations    Integration[]
  forms           Form[]
  formSubmissions FormSubmission[]
  subscription    Subscription?
  auditLogs       AuditLog[]

  @@map("tenants")
}

model User {
  id              String    @id @default(cuid())
  tenantId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  role            UserRole  @default(owner)
  featureAccess   Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  auditLogs          AuditLog[]
  sessions           Session[]
  verificationTokens VerificationToken[]

  @@index([tenantId])
  @@map("users")
}

/// One refresh-token login session. The token itself is never stored — only
/// its SHA-256. Rotated on every refresh; presenting a token rotated more
/// than a grace period ago signals theft and revokes all the user's sessions.
model Session {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  /// Which frontend app issued this session — portal and admin get separate
  /// refresh cookies (see refresh-cookie.ts) AND separate sessions, so a
  /// cookie forged under the other app's name still fails at the DB.
  appScope  SessionScope @default(portal)
  expiresAt DateTime
  rotatedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime     @default(now())

  @@index([userId])
  @@map("sessions")
}

enum SessionScope {
  portal
  admin
}

enum VerificationPurpose {
  password_reset
  email_verify
}

/// Single-use, expiring tokens for password reset and email verification —
/// same shape for both, distinguished by `purpose`. Like Session, only the
/// hash is stored; the raw token exists only in the emailed link.
model VerificationToken {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String              @unique
  purpose   VerificationPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────
// Agent configuration
// ─────────────────────────────────────────────────────────────

model Agent {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  status         AgentStatus @default(draft)
  script         String      @default("")
  requiredFields Json        @default("[]")
  hardRules      Json        @default("[]")
  widgetConfig   Json        @default("{}")
  publicToken    String      @unique @default(cuid())
  /// Optional lead form the widget can embed inline (see PublicAgentsController) — must
  /// belong to the same tenant and be status="live" to actually surface to visitors.
  leadFormId     String?
  leadForm       Form?       @relation(fields: [leadFormId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversations Conversation[]

  @@index([tenantId])
  @@index([leadFormId])
  @@map("agents")
}

// ─────────────────────────────────────────────────────────────
// Conversations
// ─────────────────────────────────────────────────────────────

model Conversation {
  id                    String              @id @default(cuid())
  agentId               String
  agent                 Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenantId              String
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel               ConversationChannel @default(chat)
  status                ConversationStatus  @default(in_progress)
  outcomeType           OutcomeType?
  capturedData          Json                @default("{}")
  transcriptText        String?
  aiSummary             String?
  /// Set once the summary job exhausts all its retry attempts — distinct
  /// from aiSummary being null while the job just hasn't run yet.
  aiSummaryError        String?
  ruleViolationsBlocked Json                @default("[]")
  recordingUrl          String?
  crmPushedAt           DateTime?
  crmExternalId         String?
  crmPushError          String?
  integrationStatus     Json                @default("{}") // { [IntegrationType]: { pushedAt?: string, error?: string } }
  createdAt             DateTime            @default(now())
  completedAt           DateTime?

  @@index([tenantId])
  @@index([agentId])
  @@map("conversations")
}

// ─────────────────────────────────────────────────────────────
// CRM
// ─────────────────────────────────────────────────────────────

model CrmConnection {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider     CrmProvider
  oauthTokens  String // encrypted at rest by the application layer
  fieldMapping Json        @default("{}")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([tenantId, provider])
  @@map("crm_connections")
}

// ─────────────────────────────────────────────────────────────
// Integrations (Google Calendar event, outbound email, custom webhook —
// all fired on conversation completion, same trigger point as CRM push)
// ─────────────────────────────────────────────────────────────

model Integration {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        IntegrationType
  config      Json            @default("{}") // per-type shape, see integrations/types.ts
  oauthTokens String? // encrypted at rest — only set for type "calendar"
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, type])
  @@map("integrations")
}

// ─────────────────────────────────────────────────────────────
// Custom lead forms — submissions route through the same CRM +
// integrations connections as completed conversations
// ─────────────────────────────────────────────────────────────

enum FormStatus {
  draft
  live
}

model Form {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  status      FormStatus @default(draft)
  schema      Json // FormSchema, validated by @envoy/types
  publicToken String     @unique @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  submissions FormSubmission[]
  agents      Agent[]

  @@index([tenantId])
  @@map("forms")
}

model FormSubmission {
  id                String    @id @default(cuid())
  formId            String
  form              Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  data              Json
  crmPushedAt       DateTime?
  crmExternalId     String?
  crmPushError      String?
  integrationStatus Json      @default("{}")
  createdAt         DateTime  @default(now())

  @@index([formId])
  @@index([tenantId])
  @@map("form_submissions")
}

// ─────────────────────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────────────────────

model Subscription {
  id                        String             @id @default(cuid())
  tenantId                  String             @unique
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status                    SubscriptionStatus @default(active)
  monthlyRate               Int // cents
  usageRate                 Int // cents per conversation over included allotment
  includedConversations     Int                @default(0)
  billingCycleDay           Int                @default(1)
  stripeCustomerId          String?
  stripeSubscriptionId      String?
  /// End instant (exclusive) of the last billing cycle overage was already invoiced for —
  /// stops chargeOverage() from double-billing if triggered twice inside the same cycle.
  lastOverageBilledCycleEnd DateTime?
  lockedAt                  DateTime?
  unlockedAt                DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action      String
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([adminUserId])
  @@map("audit_logs")
}
