generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  active
  past_due
  locked
  cancelled
}

enum UserRole {
  owner
  staff
  platform_admin
}

enum AgentStatus {
  draft
  live
  paused
}

enum ConversationChannel {
  chat
  voice
}

enum ConversationStatus {
  in_progress
  completed
  abandoned
}

enum OutcomeType {
  demo_booking
  order
  complaint
  appointment
}

enum CrmProvider {
  hubspot
}

enum IntegrationType {
  calendar
  email
  webhook
}

// ─────────────────────────────────────────────────────────────
// Core tenancy
// ─────────────────────────────────────────────────────────────

model Tenant {
  oauthCodes         OAuthCode[]
  id                 String             @id @default(cuid())
  name               String
  industry           String?
  subscriptionStatus SubscriptionStatus @default(active)
  priceConfig        Json               @default("{}")
  /// ModelConfig from @envoy/types — which credential + model serves each AI role. "{}" = platform default everywhere.
  modelConfig        Json               @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users            User[]
  agents           Agent[]
  conversations    Conversation[]
  crmConnections   CrmConnection[]
  integrations     Integration[]
  forms            Form[]
  formSubmissions  FormSubmission[]
  subscription     Subscription?
  auditLogs        AuditLog[]
  modelCredentials ModelCredential[]
  modelUsage       ModelUsage[]
  scenarios        Scenario[]
  scenarioRuns     ScenarioRun[]
  insights         Insight[]
  proposals        Proposal[]
  apiTokens        ApiToken[]
  workflows        Workflow[]
  workflowRuns     WorkflowRun[]
  optOuts          OptOut[]
  approvals        ApprovalRequest[]

  @@map("tenants")
}

model User {
  operatorTokens  OperatorToken[]
  oauthCodes      OAuthCode[]
  id              String          @id @default(cuid())
  tenantId        String?
  tenant          Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String          @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  role            UserRole        @default(owner)
  featureAccess   Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  auditLogs          AuditLog[]
  apiTokens          ApiToken[]
  sessions           Session[]
  verificationTokens VerificationToken[]

  @@index([tenantId])
  @@map("users")
}

/// One refresh-token login session. The token itself is never stored — only
/// its SHA-256. Rotated on every refresh; presenting a token rotated more
/// than a grace period ago signals theft and revokes all the user's sessions.
model Session {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  /// Which frontend app issued this session — portal and admin get separate
  /// refresh cookies (see refresh-cookie.ts) AND separate sessions, so a
  /// cookie forged under the other app's name still fails at the DB.
  appScope  SessionScope @default(portal)
  expiresAt DateTime
  rotatedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime     @default(now())

  @@index([userId])
  @@map("sessions")
}

enum SessionScope {
  portal
  admin
}

enum VerificationPurpose {
  password_reset
  email_verify
}

/// Single-use, expiring tokens for password reset and email verification —
/// same shape for both, distinguished by `purpose`. Like Session, only the
/// hash is stored; the raw token exists only in the emailed link.
model VerificationToken {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String              @unique
  purpose   VerificationPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────
// Agent configuration
// ─────────────────────────────────────────────────────────────

model Agent {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  status         AgentStatus @default(draft)
  script         String      @default("")
  requiredFields Json        @default("[]")
  hardRules      Json        @default("[]")
  widgetConfig   Json        @default("{}")
  /// Agentic half of the config (goals, tools, runtime limits) — AgentSpec in @envoy/types.
  /// "{}" parses to the classic runtime, so agents created before this column are unchanged.
  spec           Json        @default("{}")
  /// Current config version number; every config change snapshots an AgentVersion row.
  version        Int         @default(1)
  publicToken    String      @unique @default(cuid())
  /// Optional lead form the widget can embed inline (see PublicAgentsController) — must
  /// belong to the same tenant and be status="live" to actually surface to visitors.
  leadFormId     String?
  leadForm       Form?       @relation(fields: [leadFormId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversations Conversation[]
  versions      AgentVersion[]
  scenarios     Scenario[]
  scenarioRuns  ScenarioRun[]
  insights      Insight[]
  proposals     Proposal[]

  @@index([tenantId])
  @@index([leadFormId])
  @@map("agents")
}

/// Immutable snapshot of an agent's whole configuration at one version.
model AgentVersion {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenantId  String
  version   Int
  /// { script, requiredFields, hardRules, widgetConfig, spec }
  snapshot  Json
  note      String?
  createdAt DateTime @default(now())

  @@unique([agentId, version])
  @@index([tenantId])
  @@map("agent_versions")
}

// ─────────────────────────────────────────────────────────────
// Conversations
// ─────────────────────────────────────────────────────────────

model Conversation {
  id                    String              @id @default(cuid())
  agentId               String
  agent                 Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenantId              String
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel               ConversationChannel @default(chat)
  status                ConversationStatus  @default(in_progress)
  outcomeType           OutcomeType?
  capturedData          Json                @default("{}")
  transcriptText        String?
  aiSummary             String?
  /// Set once the summary job exhausts all its retry attempts — distinct
  /// from aiSummary being null while the job just hasn't run yet.
  aiSummaryError        String?
  ruleViolationsBlocked Json                @default("[]")
  recordingUrl          String?
  /// Which AgentVersion this conversation ran on.
  agentVersion          Int?
  /// { [goalId]: { status, note?, updatedAt } } — filled by the agent loop's update_goal tool.
  goalProgress          Json                @default("{}")
  /// Set when the agent handed the visitor to a human (handoff_to_human tool).
  handoffReason         String?
  /// Visitor messages sent. Null on conversations from before this was recorded.
  turnCount             Int?
  crmPushedAt           DateTime?
  crmExternalId         String?
  crmPushError          String?
  integrationStatus     Json                @default("{}") // { [IntegrationType]: { pushedAt?: string, error?: string } }
  createdAt             DateTime            @default(now())
  completedAt           DateTime?

  runSteps AgentRunStep[]

  @@index([tenantId])
  @@index([agentId])
  @@map("conversations")
}

enum RunStepKind {
  model
  tool
  judge
  extract
  limit
}

/// One step of an agent run: a model call, tool execution, judge verdict, etc.
/// The trace the portal's run viewer (and later the evaluation harness) reads.
model AgentRunStep {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenantId       String
  /// 1-based visitor turn within the conversation.
  turn           Int
  /// Order within the whole conversation (monotonic), so the trace sorts without ambiguity.
  seq            Int
  kind           RunStepKind
  name           String
  input          Json?
  output         Json?
  error          String?
  latencyMs      Int?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, seq])
  @@index([tenantId])
  @@map("agent_run_steps")
}

// ─────────────────────────────────────────────────────────────
// CRM
// ─────────────────────────────────────────────────────────────

model CrmConnection {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider     CrmProvider
  oauthTokens  String // encrypted at rest by the application layer
  fieldMapping Json        @default("{}")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([tenantId, provider])
  @@map("crm_connections")
}

// ─────────────────────────────────────────────────────────────
// Integrations (Google Calendar event, outbound email, custom webhook —
// all fired on conversation completion, same trigger point as CRM push)
// ─────────────────────────────────────────────────────────────

model Integration {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        IntegrationType
  config      Json            @default("{}") // per-type shape, see integrations/types.ts
  oauthTokens String? // encrypted at rest — only set for type "calendar"
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([tenantId, type])
  @@map("integrations")
}

// ─────────────────────────────────────────────────────────────
// Custom lead forms — submissions route through the same CRM +
// integrations connections as completed conversations
// ─────────────────────────────────────────────────────────────

enum FormStatus {
  draft
  live
}

model Form {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  status      FormStatus @default(draft)
  schema      Json // FormSchema, validated by @envoy/types
  publicToken String     @unique @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  submissions FormSubmission[]
  agents      Agent[]

  @@index([tenantId])
  @@map("forms")
}

model FormSubmission {
  id                String    @id @default(cuid())
  formId            String
  form              Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  data              Json
  crmPushedAt       DateTime?
  crmExternalId     String?
  crmPushError      String?
  integrationStatus Json      @default("{}")
  createdAt         DateTime  @default(now())

  @@index([formId])
  @@index([tenantId])
  @@map("form_submissions")
}

// ─────────────────────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────────────────────

model Subscription {
  id                        String             @id @default(cuid())
  tenantId                  String             @unique
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status                    SubscriptionStatus @default(active)
  monthlyRate               Int // cents
  usageRate                 Int // cents per conversation over included allotment
  includedConversations     Int                @default(0)
  billingCycleDay           Int                @default(1)
  stripeCustomerId          String?
  stripeSubscriptionId      String?
  /// End instant (exclusive) of the last billing cycle overage was already invoiced for —
  /// stops chargeOverage() from double-billing if triggered twice inside the same cycle.
  lastOverageBilledCycleEnd DateTime?
  lockedAt                  DateTime?
  unlockedAt                DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  adminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action      String
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([adminUserId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// Bring-your-own-model keys
// ─────────────────────────────────────────────────────────────

enum ModelProviderKind {
  anthropic
  openai
  gemini
  groq
  openai_compatible
}

enum ModelCredentialStatus {
  active
  /// The provider rejected the key (401/403) on a live call or a re-test.
  invalid
}

/// A tenant's own provider API key. The key itself is AES-256-GCM encrypted
/// (same scheme as CRM tokens) and is never returned by any API — only `last4`.
model ModelCredential {
  id           String                @id @default(cuid())
  tenantId     String
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider     ModelProviderKind
  label        String
  encryptedKey String
  last4        String
  /// Only for openai_compatible (and optional OpenAI proxies); fetched through the SSRF guard.
  baseUrl      String?
  status       ModelCredentialStatus @default(active)
  lastUsedAt   DateTime?
  lastError    String?
  createdAt    DateTime              @default(now())

  @@index([tenantId])
  @@map("model_credentials")
}

enum ModelKeySource {
  tenant
  platform
}

/// One row per model call — what the usage dashboard, and later cost caps, read.
model ModelUsage {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentialId String?
  role         String
  provider     String
  model        String
  keySource    ModelKeySource
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int
  ok           Boolean
  createdAt    DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@map("model_usage")
}

// ─────────────────────────────────────────────────────────────
// Scenarios — scripted-visitor regression tests for an agent
// ─────────────────────────────────────────────────────────────

/// A scripted visitor plus what must be true afterwards (ScenarioDef in @envoy/types).
model Scenario {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId     String
  agent       Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// string[] — what the simulated visitor says, in order.
  turns       Json
  expect      Json          @default("{}")
  sandbox     Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        ScenarioRun[]

  @@index([agentId])
  @@index([tenantId])
  @@map("scenarios")
}

/// One execution of one scenario. Runs are simulations: they never create a Conversation, lead, CRM push or billable usage.
model ScenarioRun {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Null once the scenario is deleted — the run's own copy of the name stays in `result`.
  scenarioId   String?
  scenario     Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  /// Which AgentVersion ran — so "passing" always means "passing on this version".
  agentVersion Int
  /// "current" or the label of a model variant being compared.
  variant      String    @default("current")
  passed       Boolean
  /// Set when the run itself failed (model error), as opposed to expectations failing.
  error        String?
  /// { name, transcript, checks, outcome, steps, route, tokens }
  result       Json
  latencyMs    Int
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([agentId, createdAt])
  @@index([tenantId, createdAt])
  @@map("scenario_runs")
}

// ─────────────────────────────────────────────────────────────
// Improvement harness — what went wrong, and tested fixes for it
// ─────────────────────────────────────────────────────────────

enum InsightStatus {
  open
  dismissed
}

/// A diagnosed problem in how an agent performs on real conversations (InsightKind in @envoy/types).
model Insight {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId      String
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /// Which agent version the evidence comes from.
  agentVersion Int
  kind         String
  /// Stable identity of the problem within a version (e.g. "abandon_at_field:phone"), so re-analysing updates instead of duplicating.
  fingerprint  String
  severity     String
  title        String
  detail       String
  /// InsightEvidence
  evidence     Json
  status       InsightStatus @default(open)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  proposals    Proposal[]

  @@unique([agentId, agentVersion, fingerprint])
  @@index([tenantId])
  @@map("insights")
}

enum ProposalStatus {
  pending
  tested
  approved
  rejected
}

/// A drafted change to an agent (ProposalChanges in @envoy/types), proven on its scenarios before it can be approved.
model Proposal {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  insightId      String?
  insight        Insight?       @relation(fields: [insightId], references: [id], onDelete: SetNull)
  /// The agent version this was drafted against; approving is refused once the agent has moved on.
  baseVersion    Int
  changes        Json
  rationale      String
  status         ProposalStatus @default(pending)
  /// { scenarios: { baseline, candidate, regressions[] }, replay: {...}, testedAt }
  testResult     Json?
  /// The AgentVersion created when approved.
  appliedVersion Int?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([agentId, createdAt])
  @@index([tenantId])
  @@map("proposals")
}

// ─────────────────────────────────────────────────────────────
// API tokens — how outside programs and AI agents (via MCP) act on a workspace
// ─────────────────────────────────────────────────────────────

/// A scoped, revocable credential that acts as the user who created it, never as more than they can do.
/// Only the SHA-256 of the secret is stored; the secret itself is shown once, at creation.
model ApiToken {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  tokenHash           String            @unique
  approvals           ApprovalRequest[]
  /// Set when this token came from an OAuth sign-in (an MCP client connecting), not from the tokens page.
  oauthClientId       String?
  oauthClient         OAuthClient?      @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  /// Hash of the current refresh token; rotated on every use. The previous one is kept to detect replay.
  refreshHash         String?           @unique
  previousRefreshHash String?           @unique
  refreshExpiresAt    DateTime?
  /// For recognising a token in a list — the secret's last four characters.
  last4               String
  /// e.g. ["agents:read", "agents:write"] — see API_TOKEN_SCOPES in @envoy/types.
  scopes              String[]
  expiresAt           DateTime
  revokedAt           DateTime?
  lastUsedAt          DateTime?
  createdAt           DateTime          @default(now())

  @@index([tenantId])
  @@index([userId])
  @@map("api_tokens")
}

// ─────────────────────────────────────────────────────────────
// Follow-up workflows — emails and SMS sent to leads over time
// ─────────────────────────────────────────────────────────────

enum WorkflowStatus {
  draft
  live
  paused
}

/// A definition (WorkflowDef in @envoy/types): trigger, conditions, steps, settings.
model Workflow {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  status     WorkflowStatus @default(draft)
  trigger    Json
  conditions Json           @default("{}")
  steps      Json
  settings   Json           @default("{}")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  runs       WorkflowRun[]

  @@index([tenantId, status])
  @@map("workflows")
}

enum WorkflowRunStatus {
  running
  completed
  stopped
  failed
}

/// One lead going through one workflow. Unique per (workflow, source), so a lead can never be enrolled twice.
model WorkflowRun {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowId String
  workflow   Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  /// "conversation" or "form_submission"
  sourceType String
  sourceId   String
  status     WorkflowRunStatus @default(running)
  /// Why it ended early: replied, cancelled, workflow_paused, workflow_deleted…
  stopReason String?
  /// The next step to run.
  nextStep   Int               @default(0)
  nextRunAt  DateTime?
  createdAt  DateTime          @default(now())
  finishedAt DateTime?
  logs       WorkflowStepLog[]

  @@unique([workflowId, sourceType, sourceId])
  @@index([tenantId, createdAt])
  @@index([sourceType, sourceId])
  @@map("workflow_runs")
}

enum StepLogStatus {
  sent
  skipped
  failed
  waiting
}

/// What happened at each step, so a lead's whole follow-up is auditable.
model WorkflowStepLog {
  id         String        @id @default(cuid())
  runId      String
  run        WorkflowRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  tenantId   String
  stepIndex  Int
  type       String
  status     StepLogStatus
  /// Human-readable reason when skipped or failed ("Lead opted out of SMS"), or what a wait is until.
  detail     String?
  channel    String?
  /// The recipient with the middle masked (a***@x.com, +44…0123) — enough to recognise, not to harvest.
  toMasked   String?
  /// SHA-256 of "channel:address" — lets an inbound reply or STOP be matched to exactly this contact without storing it in the clear.
  toHash     String?
  providerId String?
  createdAt  DateTime      @default(now())

  @@unique([runId, stepIndex])
  @@index([tenantId, createdAt])
  @@index([toHash])
  @@map("workflow_step_logs")
}

/// Addresses that must not be contacted again on a channel, however many workflows would otherwise reach them.
model OptOut {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "email" or "sms"
  channel   String
  /// Normalised: lower-cased email, or E.164 phone.
  address   String
  /// unsubscribed (email link), stop (SMS keyword), manual
  reason    String
  createdAt DateTime @default(now())

  @@unique([tenantId, channel, address])
  @@map("opt_outs")
}

// ─────────────────────────────────────────────────────────────
// Approval requests — how an API token asks a person for the things only a person may do
// ─────────────────────────────────────────────────────────────

enum ApprovalStatus {
  pending
  approved
  rejected
  /// Nobody answered within the window.
  expired
  /// The agent changed after the request, so what was reviewed is no longer what would happen.
  stale
  /// Approved, but carrying it out failed (nothing was changed).
  failed
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The token that asked; null when a person raised it themselves.
  tokenId     String?
  token       ApiToken?      @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  /// Display name of the token at the time, kept for the record.
  requestedBy String
  agentId     String
  /// ApprovalParams (kind + exactly what to do).
  params      Json
  /// Canonical form of `params`, re-checked when the request is carried out.
  paramsHash  String
  /// The agent's version when asked. Approval is refused if the agent has moved on.
  baseVersion Int
  /// The requester's own words. Shown to the reviewer as an unverified quote.
  reason      String?
  status      ApprovalStatus @default(pending)
  /// Why a request ended without being carried out (expired, stale, failed).
  note        String?
  decidedBy   String?
  decidedAt   DateTime?
  result      Json?
  expiresAt   DateTime
  createdAt   DateTime       @default(now())

  @@index([tenantId, status])
  @@index([agentId])
  @@map("approval_requests")
}

/// An app that connected (or tried to) via OAuth dynamic client registration. Public client: no secret, PKCE instead.
model OAuthClient {
  id           String      @id @default(cuid())
  name         String
  redirectUris String[]
  createdAt    DateTime    @default(now())
  codes        OAuthCode[]
  tokens       ApiToken[]

  @@map("oauth_clients")
}

/// A one-time authorization code, valid for minutes, bound to the client, redirect URI, PKCE challenge and the person who consented.
model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scopes        String[]
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  /// The token issued when the code was exchanged, so a replayed code can revoke it.
  tokenId       String?
  createdAt     DateTime    @default(now())

  @@map("oauth_codes")
}

/// A token for the platform operator's AI assistant (the operator MCP server). Belongs to a platform_admin; separate from workspace API tokens.
model OperatorToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  last4      String
  /// "admin:read" and/or "admin:write" — see OPERATOR_SCOPES in @envoy/types.
  scopes     String[]
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("operator_tokens")
}
