DATABASE_URL="postgresql://envoy:envoy@localhost:5432/envoy?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="dev-only-change-me"
PORT=4000

# mock | groq | gemini — defaults to mock (zero external dependencies) when unset.
LLM_PROVIDER=mock
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Gate for POST /auth/register-admin — the deliberately narrow door for minting
# the first platform_admin. Not stored anywhere, just an env var to hold.
ADMIN_BOOTSTRAP_SECRET=dev-only-bootstrap-secret

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=   # unset in dev — webhook payloads are trusted unverified locally

# mock | hubspot — defaults to mock (connects instantly, no OAuth) when unset.
CRM_PROVIDER=mock
CRM_TOKEN_ENCRYPTION_KEY=dev-only-change-me-too
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URI=http://localhost:4000/crm/callback

# mock | groq — defaults to mock. Real STT reuses GROQ_API_KEY above.
STT_PROVIDER=mock
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# mock | gemini — defaults to mock. Real TTS reuses GEMINI_API_KEY above.
TTS_PROVIDER=mock
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
