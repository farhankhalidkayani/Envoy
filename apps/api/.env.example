DATABASE_URL="postgresql://envoy:envoy@localhost:5432/envoy?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="dev-only-change-me"
PORT=4000
# Where OAuth callbacks send the browser back to.
PORTAL_URL=http://localhost:3001
# Origins allowed to send credentials (the refresh-token cookie): portal + admin.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Refresh cookies are Secure automatically when NODE_ENV=production.

# mock | groq | gemini — defaults to mock (zero external dependencies) when unset.
LLM_PROVIDER=mock
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Gate for POST /auth/register-admin — the deliberately narrow door for minting
# the first platform_admin. Not stored anywhere, just an env var to hold.
ADMIN_BOOTSTRAP_SECRET=dev-only-bootstrap-secret

# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Without a secret, webhooks are rejected. For local testing only, accept
# unsigned payloads (ignored when NODE_ENV=production):
# STRIPE_WEBHOOK_ALLOW_UNSIGNED=true
# STRIPE_PRICE_ID=  # the recurring Price used by /billing/checkout

# mock | hubspot — defaults to mock (connects instantly, no OAuth) when unset.
CRM_PROVIDER=mock
CRM_TOKEN_ENCRYPTION_KEY=dev-only-change-me-too
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URI=http://localhost:4000/crm/callback

# Integrations (calendar event / email / webhook on conversation completion)
# Calendar: unset GOOGLE_CLIENT_ID -> connects instantly in mock mode, like CRM_PROVIDER above.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/integrations/calendar/callback
# Email: unset RESEND_API_KEY -> logs instead of sending.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=envoy@resend.dev
# Webhook needs no env var — the endpoint URL is configured per-tenant in the portal.
# Tenant-supplied URLs (webhooks, API-sourced form dropdowns) may not resolve to
# private/loopback addresses. Set true ONLY in local dev to hit localhost.
# ALLOW_PRIVATE_FETCH=true

# mock | groq — defaults to mock. Real STT reuses GROQ_API_KEY above.
STT_PROVIDER=mock
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# mock | gemini — defaults to mock. Real TTS reuses GEMINI_API_KEY above.
TTS_PROVIDER=mock
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
