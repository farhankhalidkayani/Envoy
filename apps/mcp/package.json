{
  "name": "@envoy/mcp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "MCP server that lets an AI agent operate an Envoy workspace through a scoped API token.",
  "bin": {
    "envoy-mcp": "./dist/stdio.js",
    "envoy-mcp-operator": "./dist/stdio-operator.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:operator": "node dist/stdio-operator.js"
  },
  "dependencies": {
    "@envoy/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@envoy/config": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
